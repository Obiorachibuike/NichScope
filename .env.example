# ---------------------------------------------------------------------------
# NicheScope environment
# Copy to .env.local (web app) and set the same secrets on the worker host.
# Never commit real values.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-32-byte-random-secret

# Managed PostgreSQL. DIRECT_DATABASE_URL bypasses a connection pooler for
# migrations; DATABASE_URL is used by the app and the pg-boss worker.
DATABASE_URL=postgresql://user:password@host:5432/nichscope?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/nichscope?sslmode=require

# Optional: Google OAuth (both values enable the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Data API v3 (server-side only). Live lookups stay disabled without it.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_DATA_RETENTION_DAYS=30

# AI providers. AGNES is primary; OpenAI is the fallback.
AI_PROVIDER=agnes
AGNES_API_KEY=
AGNES_API_BASE_URL=https://api.agnes.ai/v1
AGNES_MODEL=agnes-1
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Worker
WORKER_ENABLED=true
WORKER_CONCURRENCY=3
WORKER_EMBEDDED=false
WORKER_PORT=3001

# Compliance gates. Do not set "approved" or "true" without documented,
# written permission from the data provider.
YOUTUBE_ANALYTICS_APPROVAL_STATUS=not_approved
LICENSED_DATA_PROVIDER_ENABLED=false
LICENSED_DATA_PROVIDER_NAME=Licensed analytics provider
LICENSED_DATA_PROVIDER_REF=

# Demo fixtures are clearly labelled and never presented as live data.
# Defaults to true outside production; set explicitly in staging.
DEMO_MODE=false

# Monitoring
SENTRY_DSN=

# Optional tuning
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
AUTH_LOGIN_MAX_PER_MINUTE=10
AI_DAILY_LIMIT_FREE=3
AI_DAILY_LIMIT_PRO=50
AI_DAILY_LIMIT_TEAM=200
AI_DAILY_COST_CAP_USD=5
